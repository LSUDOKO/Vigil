# Vigil — configuration
#
# Copy to .env.local (that is the file cmd/vigil-server reads, not .env):
#
#     cp .env.example .env.local
#
# Every value below has a working default. Vigil runs with none of them set:
# intent policy, cost forecasting, and the behavioral detectors all work with
# no credentials of any kind. The optional sections buy you AI judgement,
# trace export, and persistence.
#
# Never commit a filled-in copy. .gitignore already excludes .env* .

# ─── Core ───────────────────────────────────────────────────────────────────
VIGIL_ADDR=":8080"
VIGIL_ORG_ID="default"
# Must be the externally reachable URL in production — OAuth discovery
# advertises it to Claude Web.
VIGIL_PUBLIC_BASE="http://localhost:8080"
VIGIL_DASHBOARD_BASE="http://localhost:3000"

# ─── Cost firewall ──────────────────────────────────────────────────────────
# Per-session spend ceiling in USD. Sessions arriving outside the OAuth consent
# flow (which carries its own approved budget) get this.
VIGIL_BUDGET_LIMIT="100"
# Fraction of budget at which Vigil recommends a cheaper model route instead of
# blocking. The hard limit is the budget itself.
# VIGIL_SOFT_LIMIT_PCT="0.80"

# ─── Operator control token ─────────────────────────────────────────────────
# Guards the endpoints that kill, pause, resume, block, or re-budget an agent.
# Unset, those endpoints are OPEN and the server warns loudly at startup — which
# keeps `make demo` working with zero setup. Set this before binding anywhere
# but loopback: an unauthenticated kill switch is worse than no kill switch.
VIGIL_CONTROL_TOKEN=""

# ─── Shell execution ────────────────────────────────────────────────────────
# run_command executes `bash -c` on caller-supplied input. It is DISABLED by
# default and must be turned on deliberately. Do not enable it on a
# host reachable from an untrusted network without also adding a command
# allowlist, a restricted working directory, and OS-level resource limits.
VIGIL_ALLOW_EXEC="false"

# ─── Audit ledger ───────────────────────────────────────────────────────────
# Append-only SHA-256 hash chain of every governance decision.
# Verify with: vigil-cli audit verify [session_id]
VIGIL_AUDIT_PATH="./vigil-audit.jsonl"

# ─── Featherless inference (OPTIONAL) ───────────────────────────────────────
# Without these, Vigil runs deterministic-only: no model is consulted and no
# risk score is produced. That is a supported configuration, not a degraded
# one — it is never faked with a synthesized verdict.
#
# Model IDs have NO defaults on purpose. Catalogues change, and a hardcoded ID
# that has since been retired fails in production rather than in review. Pick
# current models from https://featherless.ai/models and name them here.
# VIGIL_FEATHERLESS_API_KEY=""
# VIGIL_FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"
#
# Cheapest/fastest — triages calls deterministic checks could not resolve.
# VIGIL_MODEL_FAST=""
# Mid-tier — adjudicates ambiguity and compiles natural-language policy.
# VIGIL_MODEL_REASONER=""
# Strongest — final word on calls already judged high risk.
# VIGIL_MODEL_REVIEWER=""
#
# VIGIL_LLM_TIMEOUT_SECONDS="8"

# ─── Detector thresholds (OPTIONAL) ─────────────────────────────────────────
# VIGIL_LOOP_MAX_REPEATS="5"
# VIGIL_RETRY_STORM_MAX="3"
# VIGIL_LATENCY_SPIKE="30s"
# VIGIL_TOOL_TIMEOUT="60s"
# VIGIL_AGENT_STUCK="120s"

# ─── SigNoz Cloud trace export (OPTIONAL) ───────────────────────────────────
# Unset: the server logs a warning and runs normally with export skipped.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://ingest.<region>.signoz.cloud"
# OTEL_EXPORTER_OTLP_HEADERS="signoz-ingestion-key=YOUR_KEY"

# ─── ClickHouse (OPTIONAL) ──────────────────────────────────────────────────
# Unset: in-memory stores. Agent DNA baselines and prompt replay need this.
# VIGIL_CLICKHOUSE_DSN=""

# ─── Incident notifications (OPTIONAL) ──────────────────────────────────────
# Unset: governance alerts go to the dashboard over WebSocket only.
# VIGIL_WEBHOOK_URL=""
# SLACK_WEBHOOK_URL=""

# ─── Frontend ───────────────────────────────────────────────────────────────
# Set in frontend/.env.local, not here. Server-side only — no NEXT_PUBLIC_
# prefix, or the value ships to the browser.
# VIGIL_BACKEND_URL="http://localhost:8080"
#
# This one IS browser-side: Next rewrites cannot proxy WebSocket upgrades, so
# the dashboard needs the socket URL directly.
# NEXT_PUBLIC_VIGIL_WS_URL="ws://localhost:8080/api/v1/vigil/ws"
